    "residue": {"type": "object", "additionalProperties": false, "required": ["structure_id", "model_id", "chain_id", "auth_seq_id", "insertion_code", "residue_name"], "properties": {"structure_id": {"type": "string"}, "model_id": {"type": "string"}, "chain_id": {"type": "string"}, "auth_seq_id": {"type": "string"}, "insertion_code": {"type": ["string", "null"]}, "residue_name": {"type": "string"}}},
