    "transform": {"type": "object", "additionalProperties": false, "required": ["rotation", "translation"], "properties": {"rotation": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/point"}}, "translation": {"$ref": "#/$defs/point"}}},
