    "sequence_ref": {"type": "object", "additionalProperties": false, "required": ["sequence_index", "one_letter", "residue_id"], "properties": {"sequence_index": {"type": "integer"}, "one_letter": {"type": "string"}, "residue_id": {"anyOf": [{"$ref": "#/$defs/residue"}, {"type": "null"}]}}},
    "msa_cell": {"type": "object", "additionalProperties": false, "required": ["structure_id", "alignment_column", "residue", "character"], "properties": {"structure_id": {"type": "string"}, "alignment_column": {"type": "integer"}, "residue": {"anyOf": [{"$ref": "#/$defs/sequence_ref"}, {"type": "null"}]}, "character": {"type": "string"}}},
    "msa_sequence": {"type": "object", "additionalProperties": false, "required": ["structure_id", "chain_id", "sequence", "source", "residues"], "properties": {"structure_id": {"type": "string"}, "chain_id": {"type": "string"}, "sequence": {"type": "string"}, "source": {"type": "string"}, "residues": {"type": "array", "items": {"$ref": "#/$defs/sequence_ref"}}}},
    "msa_column": {"type": "object", "additionalProperties": false, "required": ["index", "reference_label", "reference_residue", "cells", "non_gap_count", "gap_fraction", "ambiguous_fraction", "conservation_score", "entropy_bits"], "properties": {"index": {"type": "integer"}, "reference_label": {"type": "string"}, "reference_residue": {"anyOf": [{"$ref": "#/$defs/residue"}, {"type": "null"}]}, "cells": {"type": "array", "items": {"$ref": "#/$defs/msa_cell"}}, "non_gap_count": {"type": "integer"}, "gap_fraction": {"type": "number"}, "ambiguous_fraction": {"type": "number"}, "conservation_score": {"type": ["number", "null"]}, "entropy_bits": {"type": ["number", "null"]}}},
