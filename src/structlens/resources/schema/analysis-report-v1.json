{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structlens.org/schema/analysis-report-v1.json",
  "title": "StructLens canonical analysis report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "comparison_mode", "reference_selection", "target_selection",
    "input_quality", "analysis", "msa", "interactions", "sites", "distance_map",
    "displacement_vectors", "evidence_cards", "site_definitions", "availability",
    "diagnostics", "provenance", "pockets", "report_id"
  ],
  "properties": {
    "schema_version": {"const": "4.0"},
    "comparison_mode": {"type": "string", "enum": ["pairwise", "reference_vs_many", "all_vs_all"]},
    "reference_selection": {"$ref": "#/$defs/selection"},
    "target_selection": {"$ref": "#/$defs/selection"},
    "input_quality": {"$ref": "#/$defs/input_quality"},
    "analysis": {"anyOf": [{"$ref": "#/$defs/analysis"}, {"type": "null"}]},
    "msa": {"anyOf": [{"$ref": "#/$defs/msa"}, {"type": "null"}]},
    "interactions": {"anyOf": [{"$ref": "#/$defs/interaction_list"}, {"$ref": "#/$defs/interaction_evidence"}, {"type": "null"}]},
    "sites": {"anyOf": [{"type": "array", "items": {"$ref": "#/$defs/site_metric"}}, {"$ref": "#/$defs/site_evidence"}, {"type": "null"}]},
    "distance_map": {"anyOf": [{"$ref": "#/$defs/distance_map"}, {"type": "null"}]},
    "displacement_vectors": {"type": "array", "items": {"$ref": "#/$defs/vector"}},
    "evidence_cards": {"type": "array", "items": {"$ref": "#/$defs/evidence_card"}},
    "site_definitions": {"type": "array", "items": {"$ref": "#/$defs/site_definition"}},
    "availability": {"$ref": "#/$defs/availability"},
    "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
    "provenance": {"anyOf": [{"$ref": "#/$defs/provenance"}, {"type": "null"}]},
    "pockets": {"anyOf": [{"$ref": "#/$defs/pockets"}, {"type": "null"}]},
    "report_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_quality", "analysis", "msa", "interactions", "sites", "distance_map", "displacement_vectors", "evidence_cards", "pockets"],
      "properties": {
        "input_quality": {"$ref": "#/$defs/availability_value"},
        "analysis": {"$ref": "#/$defs/availability_value"},
        "msa": {"$ref": "#/$defs/availability_value"},
        "interactions": {"$ref": "#/$defs/availability_value"},
        "sites": {"$ref": "#/$defs/availability_value"},
        "distance_map": {"$ref": "#/$defs/availability_value"},
        "displacement_vectors": {"$ref": "#/$defs/availability_value"},
        "evidence_cards": {"$ref": "#/$defs/availability_value"},
        "pockets": {"$ref": "#/$defs/availability_value"}
      }
    },
    "availability_value": {
      "type": "string",
      "enum": ["available", "not_applicable", "not_detected", "invalid_input", "dependency_unavailable", "numerical_failure"]
    },
    "input_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "target"],
      "properties": {
        "reference": {"$ref": "#/$defs/quality"},
        "target": {"$ref": "#/$defs/quality"}
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["availability", "diagnostics", "counts", "settings", "provenance"],
      "properties": {
        "availability": {"$ref": "#/$defs/availability_value"},
        "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
        "counts": {"type": "object"},
        "settings": {"$ref": "#/$defs/qc_settings"},
        "provenance": {"anyOf": [{"$ref": "#/$defs/provenance"}, {"type": "null"}]}
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message", "source_id", "atom_id", "residue_id", "remediation"],
      "properties": {
        "code": {"type": "string"},
        "severity": {"type": "string", "enum": ["info", "warning", "error"]},
        "message": {"type": "string"},
        "source_id": {"type": ["string", "null"]},
        "atom_id": {"type": ["string", "null"]},
        "residue_id": {"type": ["string", "null"]},
        "remediation": {"type": ["string", "null"]}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method_id", "method_version", "parameters", "units", "backend_versions", "input_hashes", "analyzed_representation", "artifact_id"],
      "properties": {
        "method_id": {"type": "string"},
        "method_version": {"type": "string"},
        "parameters": {"type": "object"},
        "units": {"type": "object"},
        "backend_versions": {"type": "object"},
        "input_hashes": {"type": "object"},
        "analyzed_representation": {"type": "string"},
        "artifact_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "pockets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detections", "volumes", "matching", "comparisons", "lining_residues", "concordance", "diagnostics", "provenance", "units", "availability"],
      "properties": {
        "detections": {"type": "array", "items": {"$ref": "#/$defs/pocket_detection"}},
        "volumes": {"type": "array", "items": {"$ref": "#/$defs/pocket_volume"}},
        "matching": {"anyOf": [{"$ref": "#/$defs/pocket_matching"}, {"type": "null"}]},
        "comparisons": {"type": "array", "items": {"$ref": "#/$defs/pocket_comparison"}},
        "lining_residues": {"type": "array", "items": {"$ref": "#/$defs/pocket_lining"}},
        "concordance": {"anyOf": [{"$ref": "#/$defs/concordance"}, {"type": "null"}]},
        "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
        "provenance": {"anyOf": [{"$ref": "#/$defs/provenance"}, {"type": "null"}]},
        "units": {"type": "object"},
        "availability": {"$ref": "#/$defs/availability_value"}
      }
    },
    "analysis": {
      "type": "object", "additionalProperties": false,
      "required": ["reference_id", "target_id", "correspondences", "mutations", "sequence_identity", "sequence_coverage", "alignment_decision", "sequence_similarity", "strict_rmsd_angstrom", "refined_rmsd_angstrom", "mapped_residue_count", "refined_residue_count", "excluded_alignment_indices", "tm_score", "legacy_provenance", "transform", "method_provenance"],
      "properties": {
        "reference_id": {"type": "string"}, "target_id": {"type": "string"},
        "correspondences": {"type": "array", "items": {"$ref": "#/$defs/correspondence"}},
        "mutations": {"type": "array", "items": {"$ref": "#/$defs/mutation"}},
        "sequence_identity": {"type": "number"}, "sequence_coverage": {"type": "number"}, "alignment_decision": {"type": "string"},
        "sequence_similarity": {"type": ["number", "null"]}, "strict_rmsd_angstrom": {"type": ["number", "null"]}, "refined_rmsd_angstrom": {"type": ["number", "null"]},
        "mapped_residue_count": {"type": "integer"}, "refined_residue_count": {"type": ["integer", "null"]}, "excluded_alignment_indices": {"type": "array"}, "tm_score": {"type": ["number", "null"]},
        "legacy_provenance": {"type": "object"}, "transform": {"anyOf": [{"$ref": "#/$defs/transform"}, {"type": "null"}]}, "method_provenance": {"anyOf": [{"$ref": "#/$defs/provenance"}, {"type": "null"}]}
      }
    },
    "correspondence": {
      "type": "object", "additionalProperties": false,
      "required": ["alignment_index", "reference", "target", "reference_one_letter", "target_one_letter", "status", "sequence_score", "ca_displacement_angstrom", "backbone_rmsd_angstrom", "sidechain_rmsd_angstrom", "all_heavy_atom_rmsd_angstrom", "is_outlier", "is_key_residue", "mapping_source", "mapping_locked"],
      "properties": {
        "alignment_index": {"type": "integer"}, "reference": {"anyOf": [{"$ref": "#/$defs/residue"}, {"type": "null"}]}, "target": {"anyOf": [{"$ref": "#/$defs/residue"}, {"type": "null"}]}, "reference_one_letter": {"type": ["string", "null"]}, "target_one_letter": {"type": ["string", "null"]}, "status": {"type": "string"}, "sequence_score": {"type": ["number", "null"]}, "ca_displacement_angstrom": {"type": ["number", "null"]}, "backbone_rmsd_angstrom": {"type": ["number", "null"]}, "sidechain_rmsd_angstrom": {"type": ["number", "null"]}, "all_heavy_atom_rmsd_angstrom": {"type": ["number", "null"]}, "is_outlier": {"type": "boolean"}, "is_key_residue": {"type": "boolean"}, "mapping_source": {"type": "string"}, "mapping_locked": {"type": "boolean"}
      }
    },
    "mutation": {
      "type": "object", "additionalProperties": false,
      "required": ["alignment_index", "kind", "reference", "target", "reference_aa", "target_aa", "reference_label", "target_label", "canonical_notation", "blosum62_score", "grantham_distance", "physicochemical_class"],
      "properties": {"alignment_index": {"type": "integer"}, "kind": {"type": "string"}, "reference": {"anyOf": [{"$ref": "#/$defs/residue"}, {"type": "null"}]}, "target": {"anyOf": [{"$ref": "#/$defs/residue"}, {"type": "null"}]}, "reference_aa": {"type": ["string", "null"]}, "target_aa": {"type": ["string", "null"]}, "reference_label": {"type": "string"}, "target_label": {"type": "string"}, "canonical_notation": {"type": "string"}, "blosum62_score": {"type": ["integer", "null"]}, "grantham_distance": {"type": ["integer", "null"]}, "physicochemical_class": {"type": ["string", "null"]}}
    },
    "vector": {"type": "object", "additionalProperties": false, "required": ["reference_position", "reference_residue", "target_residue", "start_xyz", "end_xyz", "vector_xyz", "magnitude_angstrom"], "properties": {"reference_position": {"type": "string"}, "reference_residue": {"$ref": "#/$defs/residue"}, "target_residue": {"$ref": "#/$defs/residue"}, "start_xyz": {"$ref": "#/$defs/point"}, "end_xyz": {"$ref": "#/$defs/point"}, "vector_xyz": {"$ref": "#/$defs/point"}, "magnitude_angstrom": {"type": "number"}}},
