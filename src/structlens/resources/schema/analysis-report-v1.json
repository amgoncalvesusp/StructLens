    "interaction_key": {"type": "object", "additionalProperties": false, "required": ["interaction_type", "reference_position_a", "reference_position_b", "external_partner_id"], "properties": {"interaction_type": {"type": "string"}, "reference_position_a": {"type": "string"}, "reference_position_b": {"type": ["string", "null"]}, "external_partner_id": {"type": ["string", "null"]}}},
    "interaction_difference": {"type": "object", "additionalProperties": false, "required": ["key", "change", "reference_record", "target_record"], "properties": {"key": {"$ref": "#/$defs/interaction_key"}, "change": {"type": "string"}, "reference_record": {"anyOf": [{"$ref": "#/$defs/interaction_record"}, {"type": "null"}]}, "target_record": {"anyOf": [{"$ref": "#/$defs/interaction_record"}, {"type": "null"}]}}},
